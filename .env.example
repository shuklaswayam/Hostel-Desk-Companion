# Hostel Parcel Desk Environment Configuration Example
# Copy to .env to customize

# Database Mode ('sqlite', 'postgres', or 'oracle')
DB_MODE=sqlite

# Supabase / PostgreSQL Database URI (for Vercel / Cloud deployment)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Overdue Threshold (hours)
OVERDUE_HOURS_THRESHOLD=48.0

# Automated SMS Settings (Twilio or Simulated Gateway)
# Leave blank to use simulated gateway
SMS_ENABLED=True
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Automated Email Settings (SMTP or Simulated Campus Gateway)
# Leave blank to use simulated campus mail gateway
EMAIL_ENABLED=True
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=parceldesk@vitstudent.ac.in
